generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model app_user {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String?     @db.VarChar(255)
  email       String      @unique @db.VarChar(255)
  phone       String?     @unique @db.VarChar(15)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?   @db.Timestamptz(6)
  password    String
  is_admin    Boolean     @default(false)
  profile_pic Int?
  address     String?     @db.VarChar(255)
  profilePic  file?       @relation("profilePic", fields: [profile_pic], references: [id])
  cart_item   cart_item[]
  files       file[]      @relation("createdBy")
  order       order[]
  sessions    session[]
}

model cart_item {
  id         Int      @id @default(autoincrement())
  product_id Int
  user_id    String   @db.Uuid
  quantity   Int
  product    product  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user   app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, user_id])
}

model category {
  id               Int                @id @default(autoincrement())
  code             String             @unique(map: "category_name_key") @db.VarChar(255)
  name             String             @db.VarChar(255)
  product_category product_category[]
}

model discount {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(255)
  value            Decimal            @db.Decimal(14, 3)
  type             Int
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  discount_type    discount_type      @relation(fields: [type], references: [id], onDelete: NoAction, onUpdate: NoAction)
  discount_product discount_product[]
}

model discount_product {
  id          Int      @id @default(autoincrement())
  discount_id Int
  product_id  Int
  discount    discount @relation(fields: [discount_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product     product  @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model discount_type {
  id       Int        @id @default(autoincrement())
  name     String     @db.VarChar(255)
  discount discount[]
}

model order_product {
  order_id              Int
  product_id            Int
  id                    Int                      @id @default(autoincrement())
  unit_price            Decimal                  @db.Decimal(14, 3)
  line_total            Decimal                  @db.Decimal(14, 3)
  quantity              Int
  base_price            Decimal                  @db.Decimal(14, 3)
  order                 order                    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product               product                  @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderProductDiscounts order_product_discount[]
}

model order_product_discount {
  id                 Int           @id @default(autoincrement())
  discount_name      String        @db.VarChar(255)
  discount_value     Decimal       @db.Decimal(14, 3)
  discount_type_name String        @db.VarChar(255)
  order_product_id   Int
  order_product      order_product @relation(fields: [order_product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model order_status {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(255)
  is_terminal Boolean
  name        String  @unique @db.VarChar(255)
  index       Int?
  order       order[]
}

model product {
  id                     Int                  @id @default(autoincrement())
  name                   String               @unique @db.VarChar(255)
  description            String?
  created_at             DateTime             @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?            @db.Timestamptz(6)
  brand_id               Int?
  product_series_id      Int?
  os_id                  Int?
  cpu_id                 Int?
  gpu_id                 Int?
  camera_system_id       Int?
  network_technology_id  Int?
  charging_technology_id Int?
  sim_id                 Int?
  ip_rating_id           Int?
  cart_item              cart_item[]
  discount_product       discount_product[]
  order_product          order_product[]
  brand                  brand?               @relation(fields: [brand_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "product_brand_id_fkey")
  camera_system          camera_system?       @relation(fields: [camera_system_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  charging_technology    charging_technology? @relation(fields: [charging_technology_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cpu                    cpu?                 @relation(fields: [cpu_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gpu                    gpu?                 @relation(fields: [gpu_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ip_rating              ip_rating?           @relation(fields: [ip_rating_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  network_technology     network_technology?  @relation(fields: [network_technology_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  os                     os?                  @relation(fields: [os_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_series         product_series?      @relation(fields: [product_series_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sim                    sim?                 @relation(fields: [sim_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_category       product_category[]
  product_color          product_color[]
}

model product_category {
  id          Int      @id @default(autoincrement())
  category_id Int
  product_id  Int
  category    category @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product     product  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model store {
  id             Int     @id @default(autoincrement())
  city           String? @db.VarChar(255)
  district       String? @db.VarChar(255)
  street_address String? @db.VarChar(255)
  order          order[]
}

model order {
  id                Int             @id @default(autoincrement())
  user_id           String          @db.Uuid
  store_id          Int?
  order_status_id   Int
  payment_status_id Int
  total_value       Decimal         @db.Decimal(14, 3)
  shipping_address  String?
  note              String?
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?       @db.Timestamptz(6)
  payment_method_id Int
  delivery_type_id  Int
  shipping_fee      Decimal?        @db.Decimal(14, 3)
  subtotal          Decimal         @db.Decimal(14, 3)
  code              String          @unique @default(dbgenerated("random_string(15)")) @db.VarChar(15)
  user_email        String
  user_name         String
  user_phone        String
  delivery_type     delivery_type   @relation(fields: [delivery_type_id], references: [id])
  order_status      order_status    @relation(fields: [order_status_id], references: [id], onUpdate: NoAction)
  payment_method    payment_method  @relation(fields: [payment_method_id], references: [id])
  payment_status    payment_status  @relation(fields: [payment_status_id], references: [id])
  store             store?          @relation(fields: [store_id], references: [id], onUpdate: NoAction)
  app_user          app_user        @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  order_product     order_product[]
}

model file {
  id                  Int                   @id @default(autoincrement())
  name                String                @db.VarChar(255)
  url                 String
  download_url        String
  size                Int
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  user_id             String                @db.Uuid
  profilePic          app_user[]            @relation("profilePic")
  app_user            app_user              @relation("createdBy", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_color_image product_color_image[]
}

model session {
  id              Int      @id @default(autoincrement())
  session_id      String   @unique
  browser         String?  @db.VarChar(255)
  browser_version String?  @db.VarChar(255)
  os              String?  @db.VarChar(255)
  ip              String?  @db.VarChar(255)
  platform        String?  @db.VarChar(255)
  user_id         String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  expired_at      DateTime @default(dbgenerated("(now() + '30 days'::interval)")) @db.Timestamptz(6)
  app_user        app_user @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model payment_status {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(255)
  name        String  @db.VarChar(255)
  is_terminal Boolean
  index       Int?
  orders      order[]
}

model payment_method {
  id     Int     @id @default(autoincrement())
  code   String  @unique @db.VarChar(255)
  name   String  @db.VarChar(255)
  index  Int?
  orders order[]
}

model delivery_type {
  id           Int     @id @default(autoincrement())
  code         String  @unique @db.VarChar(255)
  name         String  @db.VarChar(255)
  shipping_fee Decimal @db.Decimal(14, 3)
  orders       order[]
}

model brand {
  id      Int       @id @default(autoincrement())
  name    String    @unique @db.VarChar(255)
  product product[]
}

model product_series {
  id      Int       @id(map: "product_series_pk") @default(autoincrement())
  name    String?   @db.VarChar(255)
  product product[]
}

model camera_system {
  id          Int       @id @default(autoincrement())
  front_specs String?
  back_specs  String?
  product     product[]
}

model charging_technology {
  id         Int       @id @default(autoincrement())
  port       String    @db.VarChar(255)
  technology String    @db.VarChar(255)
  product    product[]
}

model connectivity {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(255)
  product_variant product_variant[]
}

model cpu {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(255)
  manufacturer String?   @db.VarChar(255)
  core_count   Int?
  product      product[]
}

model gpu {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(255)
  manufacturer String?   @db.VarChar(255)
  core_count   Int?
  product      product[]
}

model ip_rating {
  id      Int       @id @default(autoincrement())
  name    String    @db.VarChar(255)
  product product[]
}

model network_technology {
  id      Int       @id @default(autoincrement())
  name    String    @db.VarChar(255)
  product product[]
}

model os {
  id      Int       @id @default(autoincrement())
  name    String    @db.VarChar(255)
  product product[]
}

model product_color {
  id                  Int                   @id @default(autoincrement())
  product_id          Int
  name                String                @db.VarChar(255)
  product             product               @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_color_image product_color_image[]
  product_variant     product_variant[]
}

model product_color_image {
  id               Int            @id @default(autoincrement())
  product_color_id Int?
  file_id          Int?
  is_thumbnail     Boolean        @default(false)
  file             file?          @relation(fields: [file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_color    product_color? @relation(fields: [product_color_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model product_variant {
  id               Int            @id @default(autoincrement())
  product_color_id Int?
  sku              String?        @unique @db.VarChar(255)
  price            Decimal?       @db.Decimal(14, 3)
  stock            Int?
  storage_id       Int?
  ram_id           Int?
  connectivity_id  Int?
  connectivity     connectivity?  @relation(fields: [connectivity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_color    product_color? @relation(fields: [product_color_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ram              ram?           @relation(fields: [ram_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  storage          storage?       @relation(fields: [storage_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ram {
  id              Int               @id @default(autoincrement())
  capacity        Int
  product_variant product_variant[]
}

model sim {
  id       Int       @id @default(autoincrement())
  count    Int?
  type     String?   @db.VarChar(255)
  has_esim Boolean?
  product  product[]
}

model storage {
  id              Int               @id @default(autoincrement())
  capacity        Int
  product_variant product_variant[]
}
